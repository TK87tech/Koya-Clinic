# For deployment, use the pooled PostgreSQL URL from Neon (keep sslmode=require).
# For local development, pglite:./.data stores PostgreSQL data on disk.
DATABASE_URL=pglite:./.data/local
API_KEY=replace-with-a-long-random-key
PORT=3000
# Optional, for npm run smoke. This check does not reset or book any slots.
BASE_URL=http://localhost:3000
# Optional dedicated, disposable PostgreSQL database for live integration tests.
# TEST_DATABASE_URL=postgresql://...
